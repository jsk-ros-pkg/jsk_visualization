<?xml version="1.0"?>
<package format="3">
  <name>jsk_interactive_marker</name>
  <description>jsk interactive markers</description>
  <version>3.0.1</version>
  <author email="furuta@jsk.t.u-tokyo.ac.jp">furuta</author>
  <maintainer email="furuta@jsk.t.u-tokyo.ac.jp">furuta</maintainer>
  <license>BSD-3-Clause</license>
  <url>http://ros.org/wiki/interactive_marker</url>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ros_environment</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">rosidl_default_generators</buildtool_depend>
  <!-- jsk_ros1_ros2_compat_install_python() in CMakeLists.txt -->
  <buildtool_depend condition="$ROS_VERSION == 2">jsk_ros1_ros2_compat</buildtool_depend>

  <build_depend condition="$ROS_VERSION == 1">mk</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rosbuild</build_depend>
  <build_depend condition="$ROS_VERSION == 1">cmake_modules</build_depend>
  <build_depend condition="$ROS_VERSION == 1">message_generation</build_depend>
  <exec_depend condition="$ROS_VERSION == 1">message_runtime</exec_depend>

  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>yaml-cpp</depend>
  <depend>tinyxml</depend>
  <depend>jsk_rviz_plugins</depend>

  <!-- The nodes which need the following packages are ROS 1 only (see
       CMakeLists.txt): jsk_footstep_msgs (footstep_marker), rviz (the
       TransformableMarkerOperator rviz panel), moveit_msgs, roseus (euslisp/), dynamic_tf_publisher,
       urdf and tf_conversions (urdf_model_marker, urdf_control_marker,
       interactive_marker_interface), actionlib and message_filters.
       The ROS 2 build uses jsk_recognition_msgs when it is found
       (bounding_box_marker, srv/IndexRequest.srv), and not
       jsk_recognition_utils yet (polygon_marker, footstep_marker, ...). -->
  <depend condition="$ROS_VERSION == 1">roseus</depend>
  <depend condition="$ROS_VERSION == 1">dynamic_tf_publisher</depend>
  <depend condition="$ROS_VERSION == 1">dynamic_reconfigure</depend>
  <depend condition="$ROS_VERSION == 1">urdf</depend>
  <depend condition="$ROS_VERSION == 1">tf</depend>
  <depend condition="$ROS_VERSION == 1">jsk_footstep_msgs</depend>
  <depend condition="$ROS_VERSION == 1">actionlib</depend>
  <depend condition="$ROS_VERSION == 1">eigen_conversions</depend>
  <depend condition="$ROS_VERSION == 1">tf_conversions</depend>
  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <depend condition="$ROS_VERSION == 1">roslib</depend>
  <depend condition="$ROS_VERSION == 1">message_filters</depend>
  <depend condition="$ROS_VERSION == 1">moveit_msgs</depend>
  <build_depend version_gte="1.2.0">jsk_recognition_msgs</build_depend>
  <build_export_depend condition="$ROS_VERSION == 1" version_gte="1.0.0">jsk_recognition_msgs</build_export_depend>
  <exec_depend version_gte="1.0.0">jsk_recognition_msgs</exec_depend>
  <build_depend>jsk_recognition_utils</build_depend>
  <build_export_depend condition="$ROS_VERSION == 1">jsk_recognition_utils</build_export_depend>
  <exec_depend>jsk_recognition_utils</exec_depend>
  <depend condition="$ROS_VERSION == 1">jsk_topic_tools</depend>
  <depend condition="$ROS_VERSION == 1">rviz</depend>

  <!-- ROS 2: rclcpp/tf2 instead of roscpp/tf, parameters instead of
       dynamic_reconfigure, and the ROS 1 / ROS 2 compatibility helpers -->
  <build_depend condition="$ROS_VERSION == 2">jsk_ros1_ros2_compat</build_depend>
  <build_export_depend condition="$ROS_VERSION == 2">jsk_ros1_ros2_compat</build_export_depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">std_msgs</depend>
  <depend condition="$ROS_VERSION == 2">builtin_interfaces</depend>
  <depend condition="$ROS_VERSION == 2">tf2</depend>
  <depend condition="$ROS_VERSION == 2">tf2_ros</depend>
  <depend condition="$ROS_VERSION == 2">tf2_geometry_msgs</depend>
  <depend condition="$ROS_VERSION == 2">boost</depend>
  <depend condition="$ROS_VERSION == 2">std_srvs</depend>
  <depend condition="$ROS_VERSION == 2">tf2_eigen</depend>
  <exec_depend condition="$ROS_VERSION == 2">rosidl_default_runtime</exec_depend>
  <!-- rospy_rclpy_compat of scripts/dummy_camera.py, which falls back to
       rospy without it: jsk_ros1_ros2_compat (jsk_common >= 3.0) is released
       for ROS 2 and ROS One only, not for indigo..noetic -->
  <exec_depend condition="$ROS_VERSION == 2 or $ROS_DISTRO == one">jsk_ros1_ros2_compat</exec_depend>
  <!-- launch/*.launch.py -->
  <exec_depend condition="$ROS_VERSION == 2">launch</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_ros</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">rviz2</exec_depend>

  <test_depend condition="$ROS_VERSION == 2">launch_testing</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_testing_ament_cmake</test_depend>
  <test_depend condition="$ROS_VERSION == 2">rclpy</test_depend>

  <member_of_group condition="$ROS_VERSION == 2">rosidl_interface_packages</member_of_group>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
    <rviz plugin="${prefix}/plugin_description.xml" />
  </export>

</package>
