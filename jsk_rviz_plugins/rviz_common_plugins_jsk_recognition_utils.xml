<!-- The plugins of jsk_rviz_plugins for jsk_recognition_utils on ROS 2,
     exported only when jsk_recognition_msgs and jsk_recognition_utils are
     found, see CMakeLists.txt -->
<library path="jsk_rviz_plugins">
  <class name="jsk_rviz_plugin/PolygonArray"
         type="jsk_rviz_plugins::PolygonArrayDisplay"
         base_class_type="rviz_common::Display">
    <description>
      visualize jsk_recognition_msgs/PolygonArray
    </description>
    <message_type>jsk_recognition_msgs/msg/PolygonArray</message_type>
  </class>
</library>
