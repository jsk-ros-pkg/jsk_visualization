Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 500
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Align Bottom: false
      Background Alpha: 0.800000011920929
      Background Color: 0; 0; 0
      Class: jsk_rviz_plugin/String
      Enabled: true
      Foreground Alpha: 0.800000011920929
      Foreground Color: 85; 255; 127
      Name: sample string
      Overtake Color Properties: true
      Overtake Position Properties: true
      Topic: /sample_string
      Value: true
      font: DejaVu Sans Mono
      height: 80
      left: 350
      line width: 2
      text size: 12
      top: 20
      width: 250
    - Buffer length: 100
      Class: jsk_rviz_plugin/Plotter2D
      Enabled: true
      Name: sin plot
      Show Value: true
      Topic: /value_sample
      Value: true
    - Class: jsk_rviz_plugin/OverlayImage
      Enabled: true
      Name: rviz startup image
      Topic: /image_publisher/image_raw
      Value: true
      alpha: 0.800000011920929
      height: 128
      keep aspect ratio: true
      left: 620
      overwrite alpha value: false
      top: 550
      transport hint: raw
      width: 128
    - Background Alpha: 0.5
      Background Color: 0; 0; 0
      Class: jsk_rviz_plugin/OverlayMenu
      Enabled: true
      Foreground Alpha: 1
      Foreground Color: 25; 255; 240
      Name: menu
      Overtake BG Color Properties: false
      Overtake FG Color Properties: false
      Topic: /test_menu
      Value: true
      keep centered: true
      left: 128
      top: 128
    - Class: jsk_rviz_plugin/OverlayDiagnostic
      Enabled: true
      Name: diagnostic
      Topic: /diagnostics_agg
      Value: true
      alpha: 0.800000011920929
      diagnostics namespace: /sample_diagnostics
      left: 128
      size: 128
      stall duration: 5
      top: 400
      type: SAC
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: jsk_rviz_plugin/OverlayPicker
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7853981852531433
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.7853981852531433
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1200
