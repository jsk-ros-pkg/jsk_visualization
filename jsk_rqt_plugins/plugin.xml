<library path="src">
  <!-- ImageView2Plugin, HistogramPlot, Plot2D and YesNoButton are not
       registered here because their modules are not migrated to ROS 2 yet.
       See CMakeLists.txt for the blocking dependencies. -->
  <class name="StatusLight"
         type="jsk_rqt_plugins.status_light.StatusLight"
         base_class_type="rqt_gui_py::Plugin">
    <qtgui>
      <group>
        <label>Visualization</label>
        <icon type="theme">folder</icon>
        <statustip>Plugins related to visualization.</statustip>
      </group>
      <label>Status</label>
      <icon type="theme">utilities-system-monitor</icon>
    </qtgui>
  </class>
  <class name="StringLabel"
         type="jsk_rqt_plugins.label.StringLabel"
         base_class_type="rqt_gui_py::Plugin">
    <qtgui>
      <group>
        <label>Visualization</label>
        <icon type="theme">folder</icon>
        <statustip>Plugins related to visualization.</statustip>
      </group>
      <label>String</label>
      <icon type="theme">utilities-system-monitor</icon>
    </qtgui>
  </class>
  <class name="ServiceButtons"
         type="jsk_rqt_plugins.button.ServiceButtons"
         base_class_type="rqt_gui_py::Plugin">
    <qtgui>
      <group>
        <label>Services</label>
        <icon type="theme">folder</icon>
        <statustip>Plugins related to services.</statustip>
      </group>
      <label>ServiceButton</label>
      <icon type="theme">utilities-system-monitor</icon>
    </qtgui>
  </class>
  <class name="ServiceRadioButtons"
         type="jsk_rqt_plugins.radio_button.ServiceRadioButtons"
         base_class_type="rqt_gui_py::Plugin">
    <qtgui>
      <group>
        <label>Services</label>
        <icon type="theme">folder</icon>
        <statustip>Plugins related to services.</statustip>
      </group>
      <label>ServiceRadioButton</label>
      <icon type="theme">utilities-system-monitor</icon>
    </qtgui>
  </class>
  <class name="DRCEnvironmentViewer" type="jsk_rqt_plugins.mini_maxwell.DRCEnvironmentViewer" base_class_type="rqt_gui_py::Plugin">
    <qtgui>
      <group>
        <label>Visualization</label>
        <icon type="theme">folder</icon>
        <statustip>Plugins related to visualization.</statustip>
      </group>
      <label>DRCEnvironment</label>
      <icon type="theme">utilities-system-monitor</icon>
    </qtgui>
  </class>
  <class name="Plot3D" type="jsk_rqt_plugins.plot.Plot3D" base_class_type="rqt_gui_py::Plugin">
    <description>
      A plugin visualizing numeric values in a 3D plot using matplotlib.
    </description>
    <qtgui>
      <group>
        <label>Visualization</label>
        <icon type="theme">folder</icon>
        <statustip>Plugins related to visualization.</statustip>
      </group>
      <label>Plot3D</label>
      <icon type="theme">utilities-system-monitor</icon>
      <statustip>A plugin for visualizing numeric values in a 3D plot using different plotting backends.</statustip>
    </qtgui>

  </class>
  <class name="ServiceTabbedButtons"
         type="jsk_rqt_plugins.tabbed_button.ServiceTabbedButtons"
         base_class_type="rqt_gui_py::Plugin">
    <qtgui>
      <group>
        <label>Services</label>
        <icon type="theme">folder</icon>
        <statustip>Plugins related to services.</statustip>
      </group>
      <label>ServiceTabbedButton</label>
      <icon type="theme">utilities-system-monitor</icon>
    </qtgui>
  </class>
</library>
