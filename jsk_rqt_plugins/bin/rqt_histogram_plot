#!/usr/bin/env python
import sys
import traceback

# PyQt5/6 aborts the whole process on an unhandled exception raised inside
# a Qt-invoked slot (e.g. a QTimer-driven redraw). Since this node runs
# under roslaunch with required="true", such an abort tears down the whole
# launch. Log instead of aborting.
sys.excepthook = traceback.print_exception

from rqt_gui.main import Main
try:
    from jsk_rqt_plugins.hist import HistogramPlot
except:
    import roslib; roslib.load_manifest('jsk_rqt_plugins')
    from jsk_rqt_plugins.hist import HistogramPlot

plugin = 'HistogramPlot'
main = Main(filename=plugin)
sys.exit(main.main(standalone=plugin, plugin_argument_provider=HistogramPlot.add_arguments))
