<?xml version="1.0"?>
<package format="3">
  <name>jsk_rqt_plugins</name>
  <version>3.0.0</version>
  <description>The jsk_rqt_plugins package</description>
  <maintainer email="ueda@jsk.t.u-tokyo.ac.jp">Ryohei Ueda</maintainer>
  <license>BSD</license>
  <url type="repository">http://github.com/jsk-ros-pkg/jsk_visualization</url>
  <url type="bugtracker">http://github.com/jsk-ros-pkg/jsk_visualization/issues</url>
  <url type="website">https://jsk-visualization.readthedocs.io/en/latest/jsk_rqt_plugins/index.html</url>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake_python</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ros_environment</buildtool_depend>
  <!-- jsk_ros1_ros2_compat_install_python() in CMakeLists.txt -->
  <buildtool_depend condition="$ROS_VERSION == 2">jsk_ros1_ros2_compat</buildtool_depend>

  <build_depend condition="$ROS_VERSION == 1">mk</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rosbuild</build_depend>
  <build_depend condition="$ROS_VERSION == 1">image_view2</build_depend>
  <build_depend condition="$ROS_VERSION == 1">message_generation</build_depend>

  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>
  <exec_depend>rqt_plot</exec_depend>
  <!-- rqt_image_view and image_publisher are used by the samples of the
       plugins which are ROS 1 only. -->
  <exec_depend condition="$ROS_VERSION == 1">rqt_image_view</exec_depend>
  <exec_depend>qt_gui_py_common</exec_depend>
  <exec_depend>resource_retriever</exec_depend>
  <!-- https://github.com/ros-perception/image_pipeline/pull/318 -->
  <exec_depend condition="$ROS_VERSION == 1" version_gte="1.12.23">image_publisher</exec_depend>
  <exec_depend>image_view2</exec_depend>
  <exec_depend version_gte="4.3.0" >jsk_gui_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend condition="$ROS_PYTHON_VERSION == 2">python-sklearn</exec_depend>
  <exec_depend condition="$ROS_PYTHON_VERSION == 3">python3-sklearn</exec_depend>
  <!-- hist.py and plot_2d.py (HistogramPlot, Plot2D) need
       jsk_recognition_msgs; on ROS 2 they are installed only when it is found
       at build time (CMakeLists.txt) -->
  <build_depend condition="$ROS_VERSION == 2">jsk_recognition_msgs</build_depend>
  <exec_depend>jsk_recognition_msgs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">message_runtime</exec_depend>
  <!-- rospy_rclpy_compat.py, the ROS 1 / ROS 2 compatibility helpers, of
       src/jsk_rqt_plugins/compat.py, which falls back to rospy without it:
       jsk_ros1_ros2_compat (jsk_common >= 3.0) is released for ROS 2 and
       ROS One only, not for indigo..noetic -->
  <exec_depend condition="$ROS_VERSION == 2 or $ROS_DISTRO == one">jsk_ros1_ros2_compat</exec_depend>
  <!-- implicit on ROS 1 (rqt_plot and friends pull them in), not on ROS 2 -->
  <exec_depend condition="$ROS_VERSION == 2">python_qt_binding</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">builtin_interfaces</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">rosidl_runtime_py</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">rqt_py_common</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">std_msgs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">std_srvs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">python3-matplotlib</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">python3-numpy</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">python3-opencv</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">python3-yaml</exec_depend>
  <!-- sample/*.launch.py -->
  <exec_depend condition="$ROS_VERSION == 2">ament_index_python</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_ros</exec_depend>

  <test_depend condition="$ROS_VERSION == 1">roslaunch</test_depend>
  <test_depend condition="$ROS_VERSION == 1">rostest</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_cmake_pytest</test_depend>
  <test_depend condition="$ROS_VERSION == 2">diagnostic_msgs</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_testing</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_testing_ament_cmake</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_ros</test_depend>
  <test_depend condition="$ROS_VERSION == 2">python3-pytest</test_depend>
  <test_depend condition="$ROS_VERSION == 2">rosidl_runtime_py</test_depend>
  <test_depend condition="$ROS_VERSION == 2">visualization_msgs</test_depend>
  <!-- the rqt test needs an X display; CI runs it under Xvfb -->
  <test_depend condition="$ROS_VERSION == 2">xvfb</test_depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml" />
  </export>
</package>
